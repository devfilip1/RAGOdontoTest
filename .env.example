# Copie para .env e ajuste. Os valores abaixo são os padrões usados quando a variável não existe.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Modelo que julga os critérios de comportamento na avaliação. Sem esta variável, usa o modelo de chat.
